@page "/profile"
@rendermode InteractiveServer
@inject TemporalProfileApiClient ProfileApi

<PageTitle>User Profile</PageTitle>

<h1>Edit User Profile</h1>

<div class="mb-3">
    <label class="form-label fw-semibold">Acting as</label>
    <select class="form-select" style="max-width:350px" @bind="selectedUser" @bind:after="OnUserChanged">
        <option value="admin">Admin User (admin@example.com)</option>
        <option value="user">Regular User (user@example.com)</option>
    </select>
    <div class="form-text">Simulates switching between seeded users (no real auth in this PoC).</div>
</div>

@if (profile is null && !isError)
{
    <p><em>Loading profile...</em></p>
}
else if (profile is not null)
{
    <div class="card" style="max-width:500px">
        <div class="card-body">
            <p class="text-muted mb-3">
                Email: <strong>@profile.Email</strong>
                &nbsp;|&nbsp;
                Role: <span class="badge bg-@(profile.Role == "admin" ? "danger" : "secondary")">@profile.Role</span>
            </p>

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="editName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Bio</label>
                <textarea class="form-control" rows="3" @bind="editBio"></textarea>
            </div>

            <button class="btn btn-primary" @onclick="SaveProfile" disabled="@isSaving">
                @(isSaving ? "Saving…" : "Save Changes")
            </button>

            @if (message is not null)
            {
                <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0">
                    @message
                </div>
            }
        </div>
        <div class="card-footer text-muted small">
            Last updated: @profile.UpdatedAt.ToLocalTime().ToString("g")
            &nbsp;|&nbsp;
            Audit history: <a href="http://localhost:8233" target="_blank">Temporal UI</a>
        </div>
    </div>
}

@code {
    private static readonly Guid AdminId = new("00000000-0000-0000-0000-000000000001");
    private static readonly Guid RegularUserId = new("00000000-0000-0000-0000-000000000002");

    private string selectedUser = "admin";
    private UserProfile? profile;
    private string? editName;
    private string? editBio;
    private bool isSaving;
    private string? message;
    private bool isError;

    private Guid ActorId => selectedUser == "admin" ? AdminId : RegularUserId;
    private string ActorRole => selectedUser == "admin" ? "admin" : "user";

    protected override async Task OnInitializedAsync() => await LoadProfile();

    private async Task OnUserChanged()
    {
        message = null;
        isError = false;
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        profile = null;
        try
        {
            profile = await ProfileApi.GetProfileAsync(ActorId);
            if (profile is not null)
            {
                editName = profile.Name;
                editBio = profile.Bio;
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Failed to load profile: {ex.Message}";
        }
    }

    private async Task SaveProfile()
    {
        if (profile is null) return;
        isSaving = true;
        message = null;
        isError = false;

        try
        {
            profile = await ProfileApi.UpdateProfileAsync(
                ActorId, ActorId, ActorRole, editName, editBio);
            message = "Profile updated! Check Temporal UI to see the audit event.";
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
