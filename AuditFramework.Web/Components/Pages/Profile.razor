@page "/profile"
@rendermode InteractiveServer
@inject TemporalProfileApiClient ProfileApi
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>User Profile</PageTitle>

<h1>Edit User Profile</h1>

@if (!isAuthenticated)
{
    <div class="alert alert-info">
        Please <a href="/login">sign in</a> to edit your profile.
    </div>
}
else if (profile is null && !isError)
{
    <p><em>Loading profile...</em></p>
}
else if (profile is not null)
{
    @if (isEditingOther)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" style="max-width:500px">
            <span class="bi bi-shield-fill-exclamation"></span>
            Editing as admin on behalf of <strong>@profile.Email</strong>.
            <a href="/users" class="ms-auto">← Back to Users</a>
        </div>
    }

    <div class="card" style="max-width:500px">
        <div class="card-body">
            <p class="text-muted mb-3">
                Email: <strong>@profile.Email</strong>
                &nbsp;|&nbsp;
                Role: <span class="badge bg-@(profile.Role == "admin" ? "danger" : "secondary")">@profile.Role</span>
            </p>

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="editName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Bio</label>
                <textarea class="form-control" rows="3" @bind="editBio"></textarea>
            </div>

            <button class="btn btn-primary" @onclick="SaveProfile" disabled="@isSaving">
                @(isSaving ? "Saving…" : "Save Changes")
            </button>

            @if (message is not null)
            {
                <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0">
                    @message
                </div>
            }
        </div>
        <div class="card-footer text-muted small">
            Last updated: @profile.UpdatedAt.ToLocalTime().ToString("g")
            &nbsp;|&nbsp;
            Audit history: <a href="http://localhost:8233" target="_blank">Temporal UI</a>
        </div>
    </div>
}
else if (isError)
{
    <div class="alert alert-danger">@message</div>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "userId")]
    public Guid? TargetUserId { get; set; }

    private static readonly Dictionary<string, (Guid Id, string Role)> UserMap = new()
    {
        ["admin@example.com"] = (new Guid("00000000-0000-0000-0000-000000000001"), "admin"),
        ["user@example.com"]  = (new Guid("00000000-0000-0000-0000-000000000002"), "user"),
    };

    private bool isAuthenticated;
    private bool isEditingOther;
    private Guid actorId;
    private string actorRole = "user";
    private Guid targetUserId;
    private UserProfile? profile;
    private string? editName;
    private string? editBio;
    private bool isSaving;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var email = state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    ?? state.User.Identity?.Name;

        if (string.IsNullOrEmpty(email) || !state.User.Identity!.IsAuthenticated)
        {
            isAuthenticated = false;
            return;
        }

        isAuthenticated = true;

        if (!UserMap.TryGetValue(email, out var mapped))
            mapped = (new Guid("00000000-0000-0000-0000-000000000002"), "user");

        actorId   = mapped.Id;
        actorRole = mapped.Role;

        // Admin can edit another user via ?userId=xxx
        if (TargetUserId.HasValue && actorRole == "admin" && TargetUserId.Value != actorId)
        {
            targetUserId  = TargetUserId.Value;
            isEditingOther = true;
        }
        else
        {
            targetUserId = actorId;
        }

        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        profile = null;
        try
        {
            profile = await ProfileApi.GetProfileAsync(targetUserId);
            if (profile is not null)
            {
                editName = profile.Name;
                editBio  = profile.Bio;
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Failed to load profile: {ex.Message}";
        }
    }

    private async Task SaveProfile()
    {
        if (profile is null) return;
        isSaving = true;
        message  = null;
        isError  = false;

        try
        {
            profile = await ProfileApi.UpdateProfileAsync(
                targetUserId, actorId, actorRole, editName, editBio);
            message = "Profile updated! Check Temporal UI to see the audit event.";
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
